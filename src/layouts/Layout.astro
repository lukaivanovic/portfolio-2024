---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Software designer portfolio." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Software designer" />
    <meta property="og:image" content="https://ivanovicluka.co/og-image.png" />
    <meta property="og:url" content="https://lukaivanovic.co" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@lukaivnvc" />
    <meta name="twitter:title" content="Luka Ivanovic" />
    <meta name="twitter:description" content="Software designer" />
    <meta
      name="twitter:image"
      content="https://ivanovicluka.co/twitter-image.png"
    />
    <title>Luka Ivanovic</title>
  </head>
  <body class="antialiased relative">
    <slot />
  </body>
</html>

<script src="../scripts/tsushima/main.js"></script>

<style is:global lang="scss">
  @use "../styles/global.css";

  @font-face {
    font-family: "TWK Lausanne - 450";
    src: url("/fonts/TWKLausanne-450.woff2") format("woff2");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "TWK Lausanne - 400";
    src:
      url("/fonts/TWKLausanne-350.otf") format("opentype"),
      url("/fonts/TWKLausanne-350.ttf") format("truetype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  .text-regular {
    font-family: "TWK Lausanne - 400", sans-serif;
  }

  .text-medium {
    font-family: "TWK Lausanne - 450", sans-serif;
  }

  body {
    font-family: "TWK Lausanne - 400", sans-serif;
    font-size: 15px;
    // line-height: 1.6;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
    background-color: var(--color-bg);
    color: var(--color-primary);
  }

  :root {
    --color-bg: #050505;
    --color-primary: white;
    --color-secondary: var(--color-neutral-400);
    --color-border: #b0b0b0;
  }

  .text-primary {
    color: var(--color-primary);
  }

  .text-secondary {
    color: var(--color-secondary);
  }

  .container {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 16px;
    padding-right: 16px;

    &.-wide {
      max-width: 900px;
    }
  }

  h1 {
    font-size: 34px;
    line-height: 1.25;
    font-family: "TWK Lausanne - 450", sans-serif;
  }

  h2 {
    font-family: "TWK Lausanne - 400", sans-serif;
    font-size: 17px;
    line-height: 1.6;
    letter-spacing: 0.02em;
  }

  img {
    border-radius: 6px;
  }

  p {
    font-family: "TWK Lausanne - 400", sans-serif;
    font-size: 15px;
    line-height: 1.6;
    letter-spacing: 0.03em;
    color: var(--color-neutral-300);
  }

  a {
    &.default {
      position: relative; // Needed for absolute positioning of :after
      // color: var(--color-secondary);
      text-decoration: none; // Remove default underline

      &:after {
        content: "";
        position: absolute;
        width: 100%;
        height: 1px; // Underline thickness
        background-color: var(--color-neutral-700); // Underline color
        bottom: -1px; // Distance below text
        left: 0;
        transition: background-color 0.3s ease; // Smooth transition on hover
      }

      &:hover {
        color: var(--color-primary); // Text color on hover

        &:after {
          background-color: var(--color-primary); // Underline color on hover
        }
      }
    }

    .chevron {
      transition: transform 0.3s ease;
    }

    &:hover {
      // color: var(--color-primary);

      .chevron {
        transform: translateX(2px);
      }
    }
  }

  @media (max-width: 1024px) {
    .container {
      padding-left: 16px;
      padding-right: 16px;

      &.-wide {
        padding-left: 16px;
        padding-right: 16px;
      }
    }

    .inner-container {
      padding-left: 16px;
      padding-right: 16px;
    }

    h1 {
      font-size: 32px;
      line-height: 1.2;
    }

    h2 {
      font-size: 24px;
      line-height: 1.2;
    }

    p {
      font-size: 15px;
      line-height: 1.6;
    }
  }
</style>
