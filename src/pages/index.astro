---
import Layout from "../layouts/Layout.astro";
import ProjectHeader from "../components/ProjectHeader.astro";
import WwEditor from "../components/WwEditor.astro";
import WwAi from "../components/WwAi.astro";
import WwComponents from "../components/WwComponents.astro";
import Tsushima from "../components/tsushima/Tsushima.astro";
import "../styles/global.css";
import RadialMenu from "../components/radial-menu/RadialMenu.jsx";
import apollon from "../svg/apollon.svg?raw";
import AiToggle from "../components/ww/AiToggle.vue";
---

<Layout title="Home">
  <!-- Navigation -->
  <section>
    <div class="container flex flex-col justify-start text-primary mt-6">
      <a href="/" class="text-primary"
        >Luka Ivanovic <br />
        <span class="text-secondary">Design × Code</span>
      </a>
    </div>
  </section>

  <!-- Hero -->
  <section>
    <div class="container flex flex-col justify-center pt-[140px] pb-[200px]">
      <h1 class="mb-6">
        A designer who codes building beautiful software. Enjoys deep diving
        into the product and business vision.
      </h1>

      <h2 class="mb-6 text-neutral-400">
        Most recently spent three years at weweb as the founding designer
        working on an app builder.
      </h2>
      <h2 class="mb-6 text-neutral-400">
        Currently on the lookout for a new opportunity, in the meantime
        improving my craft and learning new things. Reach out to me at
        <a href="mailto:lluka.ivanovic@gmail.com" class="underline"
          >lluka.ivanovic@gmail.com</a
        > or on my <a
          href="https://x.com/lukaivnvc"
          target="_blank"
          class="underline">X profile</a
        >.
      </h2>
    </div>
  </section>

  <section class="pb-[80px]">
    <div class="container flex items-center justify-center gap-2">
      <div class="h-[1px] bg-neutral-700 w-full"></div>
    </div>
  </section>

  <div class="container flex flex-row items-center justify-between pb-[40px]">
    <div class="rounded-md flex flex-row items-center justify-center gap-2">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        fill="none"
        viewBox="0 0 16 16"
        class="rounded-sm overflow-hidden text-neutral-700"
      >
        <path fill="currentColor" d="M0 0h16v16H0z"></path>
        <path
          fill="white"
          d="M9.746 9.473H6.291a.117.117 0 0 0-.12.115v2.294c0 .063.054.115.12.115h5.707L9.746 9.473Z"
        ></path>
        <path
          fill="white"
          d="M9.746 6.585v2.89l2.252 2.524V6.585a.117.117 0 0 0-.12-.115H9.867a.117.117 0 0 0-.12.115ZM6.25 9.414v-2.89L3.998 4v5.414c0 .064.054.115.12.115H6.13a.117.117 0 0 0 .119-.115Z"
        ></path>
        <path
          fill="white"
          d="M6.211 6.632h3.4c.083 0 .15-.054.15-.12V4.12c0-.066-.067-.12-.15-.12H4.003l2.21 2.632Z"
        ></path>
      </svg>

      weweb
    </div>
    <span class="text-neutral-400 text-sm">2022 - 2025</span>
  </div>

  <WwEditor />

  <section class="container flex flex-row gap-4 mt-[80px]">
    <div class="w-[1px] flex-shrink-0 bg-neutral-700 rounded-full"></div>
    <div class="py-2 flex flex-col gap-2">
      <p>
        "He’s autonomous, proactive, and knows how to deliver under pressure
        without compromising quality. If you’re looking for someone who can own
        a design system, deliver high-quality UI, and collaborate seamlessly
        with product and engineering teams, he’s the one."
      </p>
      <span class="text-neutral-400">
        — Florian Briou-Rolle, co-founder and CPO</span
      >
    </div>
  </section>

  <section class="container flex flex-row gap-4 mt-[40px]">
    <div class="w-[1px] flex-shrink-0 bg-neutral-700 rounded-full"></div>
    <div class="py-2 flex flex-col gap-2">
      <p>
        "I have been playing with WeWeb the last few days very intensely and it
        is such a great tool. It’s way more superior than anything else out
        there on the market I have used in the last five years."
      </p>
      <span class="text-neutral-400"> — Community member</span>
    </div>
  </section>

  <WwAi />

  <WwComponents />

  <section class="pb-[80px] pt-[240px]">
    <div class="container flex items-center justify-center gap-2">
      <div class="h-[1px] bg-neutral-700 w-full"></div>
    </div>
  </section>

  <section class="pb-[200px]">
    <div class="container">
      <h1 class="mb-2">Playground</h1>

      <p class="mb-6">
        Place where I experiment with new ideas and technologies.
      </p>

      <div>
        <div class="grid grid-cols-1 gap-4">
          <div
            class="relative aspect-[8/5] rounded-lg overflow-hidden flex flex-col"
          >
            <div
              class="w-full h-full flex-grow flex items-center justify-center"
            >
              <Tsushima />
            </div>

            <div class="absolute bottom-2 left-2 text-white opacity-50">
              Dissolve Effect
            </div>

            <div
              class="absolute bottom-2 right-2 text-white flex items-center gap-2 opacity-50"
            >
              three.js
            </div>
          </div>

          <!-- <div
            class="relative aspect-square bg-white border border-neutral-700 rounded-lg overflow-hidden"
          >
            <div class="w-full h-full flex items-center justify-center">
              <canvas id="riveCanvas" style="width: 100%; height: 100%;"
              ></canvas>
            </div>
            <div
              class="absolute bottom-2 left-2 bg-neutral-200 text-black px-2 py-1 rounded-full"
            >
              7-segment display
            </div>

            <div
              class="absolute bottom-2 right-2 bg-neutral-200 text-black px-2 py-1 rounded-full flex items-center gap-2"
            >
              <svg
                role="img"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
                ><path
                  fill="#000"
                  d="M.38 0a.268.268 0 0 0-.256.332l2.894 11.716a.268.268 0 0 0 .01.04l2.89 11.708a.268.268 0 0 0 .447.128L23.802 7.15a.268.268 0 0 0-.112-.45l-5.784-1.667a.268.268 0 0 0-.123-.035L6.38 1.715a.268.268 0 0 0-.144-.04L.456.01A.268.268 0 0 0 .38 0zm.374.654L5.71 2.08 1.99 5.664zM6.61 2.34l4.864 1.4-3.65 3.515zm-.522.12l1.217 4.926-4.877-1.4zm6.28 1.538l4.878 1.404-3.662 3.53zm-.52.13l1.208 4.9-4.853-1.392zm6.3 1.534l4.947 1.424-3.715 3.574zm-.524.12l1.215 4.926-4.876-1.398zm-15.432.696l4.964 1.424-3.726 3.586zM8.047 8.15l4.877 1.4-3.66 3.527zm-.518.137l1.236 5.017-4.963-1.432zm6.274 1.535l4.965 1.425-3.73 3.586zm-.52.127l1.235 5.012-4.958-1.43zm-9.63 2.438l4.873 1.406-3.656 3.523zm5.854 1.687l4.863 1.403-3.648 3.51zm-.54.04l1.214 4.927-4.875-1.4zm-3.896 4.02l5.037 1.442-3.782 3.638z"
                ></path></svg
              >
              three.js
            </div>
          </div> -->

          <div
            class="aspect-[8/5] bg-neutral-800 rounded-lg overflow-hidden relative text-black"
          >
            <div class="w-full h-full flex items-center justify-center">
              <AiToggle client:only="vue" />
            </div>

            <div class="absolute bottom-2 left-2 text-white opacity-50">
              Radial Menu
            </div>

            <div
              class="absolute bottom-2 right-2 flex items-center gap-2 text-white opacity-50"
            >
              Vue
            </div>
          </div>

          <div
            class="aspect-[8/5] bg-neutral-400 rounded-lg overflow-hidden relative"
          >
            <div class="w-full h-full flex items-center justify-center">
              <RadialMenu client:only="react" />
            </div>

            <div class="absolute bottom-2 left-2 text-black opacity-50">
              Radial Menu
            </div>

            <div
              class="absolute bottom-2 right-2 flex items-center gap-2 text-black opacity-50"
            >
              React
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div
    class="container relative overflow-hidden flex flex-col items-center justify-end mt-[200px]"
  >
  </div>

  <div class="h-4"></div>
</Layout>

