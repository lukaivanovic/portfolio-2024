---
import { Image } from "astro:assets";
import wwEditorMain from "../images/test2.jpg";
import wwEditorWorkflow from "../images/workflows.jpg";
import wwEditorIcons from "../images/icons.png";
import branching from "../images/branching.png";
import publish from "../images/publish.png";
import ProjectHeader from "./ProjectHeader.astro";
---

<section>
  <div class="container">
    <div class="image-gallery">
      <div
        class="relative main-image-container overflow-hidden rounded-lg mb-4 aspect-[8/5]"
      >
        <img
          id="mainImage"
          src={wwEditorMain.src}
          alt="WeWeb Editor Main View"
          class="w-full hover:scale-[1.02] will-change-transform transition-all duration-300"
        />
      </div>
      <div class="thumbnails-container flex gap-2 overflow-x-auto pb-2">
        <button
          class="thumbnail-btn active overflow-hidden rounded-md border-2 border-[#274076]"
          data-src={wwEditorMain.src}
          data-alt="WeWeb Editor Main View"
        >
          <img src={wwEditorMain.src} alt="WeWeb Editor Main View" />
        </button>
        <button
          class="thumbnail-btn overflow-hidden rounded-md border-2 border-transparent"
          data-src={wwEditorWorkflow.src}
          data-alt="WeWeb Editor Workflow"
        >
          <img src={wwEditorWorkflow.src} alt="WeWeb Editor Workflow" />
        </button>
        <button
          class="thumbnail-btn overflow-hidden rounded-md border-2 border-transparent"
          data-src={wwEditorIcons.src}
          data-alt="WeWeb Editor Icons"
        >
          <img src={wwEditorIcons.src} alt="WeWeb Editor Icons" />
        </button>
        <button
          class="thumbnail-btn overflow-hidden rounded-md border-2 border-transparent"
          data-src={branching.src}
          data-alt="WeWeb Editor Branching"
        >
          <img src={branching.src} alt="WeWeb Editor Branching" />
        </button>
        <button
          class="thumbnail-btn overflow-hidden rounded-md border-2 border-transparent"
          data-src={publish.src}
          data-alt="WeWeb Editor Publishing"
        >
          <img src={publish.src} alt="WeWeb Editor Publishing" />
        </button>
      </div>
    </div>
  </div>

