---
import ProjectHeader from "./ProjectHeader.astro";
import DialogPreview from "./ww/dialog/DialogPreview.vue";
---

<section>
  <div class="container py-4 rounded-md mt-[80px]">
    <div
      class="relative rounded-md md:col-span-3 col-span-1 overflow-hidden aspect-[8/5]"
    >
      <DialogPreview client:only="vue" class="h-full" />
    </div>

    <div class="flex justify-between items-center pt-6">
      <div>
        <h2 class="text=primary mb-1">
          Designing and building the most powerful no-code component toolkit
        </h2>
        <div class="text-secondary">
          Radix-inspired components such as select, dropdown, dialog, and more.
        </div>
      </div>

      <!-- <a href="/posts/components" class="flex items-center gap-1">
        Read more
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          fill="currentColor"
          viewBox="0 0 256 256"
          ><path
            d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"
          ></path></svg
        >
      </a> -->

      <span class="text-secondary text-sm">Coming soon</span>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/global.css";

  p {
    color: white;
  }

  .dropdown {
    inset: -2;
    border: 1px dashed;
    @apply border-purple-400;

    &:after {
      content: "DROPDOWN";
      position: absolute;
      top: calc(50% - 9px);
      left: calc(100% + 4px);
      @apply bg-purple-500/50;
      @apply text-purple-100;
      font-size: 9px;
      font-family: monospace;
      padding: 2px 2px;
      border-radius: 4px;
      pointer-events: none;
      // z-index: 9999;
    }
  }

  .search {
    inset: -2;
    border: 1px dashed;
    @apply border-orange-400;

    &:after {
      content: "SEARCH";
      position: absolute;
      top: calc(50% - 9px);
      right: calc(100% + 16px);
      @apply bg-orange-500/50;
      @apply text-orange-100;
      font-size: 9px;
      font-family: monospace;
      padding: 2px 2px;
      border-radius: 4px;
      pointer-events: none;
      // z-index: 9999;
    }
  }

  .option {
    inset: -2;
    border: 1px dashed;
    @apply border-green-400;

    &:after {
      content: "OPTION";
      position: absolute;
      top: calc(50% - 9px);
      right: calc(100% + 16px);
      @apply bg-green-500/50;
      @apply text-green-100;
      font-size: 9px;
      font-family: monospace;
      padding: 2px 2px;
      border-radius: 4px;
      pointer-events: none;
      // z-index: 9999;
    }
  }

  .trigger {
    inset: -2;
    border: 1px dashed;
    @apply border-cyan-400;

    &:after {
      content: "TRIGGER";
      position: absolute;
      top: calc(50% - 9px);
      left: calc(100% + 4px);
      @apply bg-cyan-500/50;
      @apply text-cyan-100;
      font-size: 9px;
      font-family: monospace;
      padding: 2px 2px;
      border-radius: 4px;
      pointer-events: none;
      // z-index: 9999;
    }
  }

  .tab-trigger {
    inset: -2;
    border: 1px dashed;
    @apply border-cyan-400;

    &:after {
      content: "TRIGGER";
      position: absolute;
      bottom: calc(100% + 8px);
      left: 0;
      @apply bg-cyan-500/50;
      @apply text-cyan-100;
      font-size: 9px;
      font-family: monospace;
      padding: 2px 2px;
      border-radius: 4px;
      pointer-events: none;
      // z-index: 9999;
    }
  }

  .tab-content {
    inset: -2;
    border: 1px dashed;
    @apply border-rose-400;

    &:after {
      content: "CONTENT";
      position: absolute;
      top: calc(50%);
      left: calc(100% + 8px);
      @apply bg-rose-500/50;
      @apply text-rose-100;
      font-size: 9px;
      font-family: monospace;
      padding: 2px 2px;
      border-radius: 4px;
      pointer-events: none;
      // z-index: 9999;
    }
  }
</style>
