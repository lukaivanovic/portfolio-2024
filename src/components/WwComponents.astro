---
import ProjectHeader from "./ProjectHeader.astro";
import DialogPreview from "./ww/dialog/DialogPreview.vue";
---

<section>
  <div class="container">
    <div
      class="col-span-1 row-span-1 md:col-span-2 md:row-span-2 min-h-[480px]"
    >
      <DialogPreview client:only="vue" class="h-full" />
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/global.css";

  .dropdown {
    inset: -2;
    border: 1px dashed;
    @apply border-purple-400;

    &:after {
      content: "DROPDOWN";
      position: absolute;
      top: calc(50% - 9px);
      left: calc(100% + 4px);
      @apply bg-purple-500/50;
      @apply text-purple-100;
      font-size: 9px;
      font-family: monospace;
      padding: 2px 2px;
      border-radius: 4px;
      pointer-events: none;
      // z-index: 9999;
    }
  }

  .search {
    inset: -2;
    border: 1px dashed;
    @apply border-orange-400;

    &:after {
      content: "SEARCH";
      position: absolute;
      top: calc(50% - 9px);
      right: calc(100% + 16px);
      @apply bg-orange-500/50;
      @apply text-orange-100;
      font-size: 9px;
      font-family: monospace;
      padding: 2px 2px;
      border-radius: 4px;
      pointer-events: none;
      // z-index: 9999;
    }
  }

  .option {
    inset: -2;
    border: 1px dashed;
    @apply border-green-400;

    &:after {
      content: "OPTION";
      position: absolute;
      top: calc(50% - 9px);
      right: calc(100% + 16px);
      @apply bg-green-500/50;
      @apply text-green-100;
      font-size: 9px;
      font-family: monospace;
      padding: 2px 2px;
      border-radius: 4px;
      pointer-events: none;
      // z-index: 9999;
    }
  }

  .trigger {
    inset: -2;
    border: 1px dashed;
    @apply border-cyan-400;

    &:after {
      content: "TRIGGER";
      position: absolute;
      top: calc(50% - 9px);
      left: calc(100% + 4px);
      @apply bg-cyan-500/50;
      @apply text-cyan-100;
      font-size: 9px;
      font-family: monospace;
      padding: 2px 2px;
      border-radius: 4px;
      pointer-events: none;
      // z-index: 9999;
    }
  }

  .tab-trigger {
    inset: -2;
    border: 1px dashed;
    @apply border-cyan-400;

    &:after {
      content: "TRIGGER";
      position: absolute;
      bottom: calc(100% + 8px);
      left: 0;
      @apply bg-cyan-500/50;
      @apply text-cyan-100;
      font-size: 9px;
      font-family: monospace;
      padding: 2px 2px;
      border-radius: 4px;
      pointer-events: none;
      // z-index: 9999;
    }
  }

  .tab-content {
    inset: -2;
    border: 1px dashed;
    @apply border-rose-400;

    &:after {
      content: "CONTENT";
      position: absolute;
      top: calc(50%);
      left: calc(100% + 8px);
      @apply bg-rose-500/50;
      @apply text-rose-100;
      font-size: 9px;
      font-family: monospace;
      padding: 2px 2px;
      border-radius: 4px;
      pointer-events: none;
      // z-index: 9999;
    }
  }
</style>
