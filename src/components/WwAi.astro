---
import ProjectHeader from "./ProjectHeader.astro";
import AiToggle from "./ww/AiToggle.vue";
import WwChat from "./ww/WwChat.vue";
import { Image } from "astro:assets";
import background from "../images/bg2.png";
import WwAiContext from "./ww/WwAiContext.vue";
---

<section>
  <div class="container">
    <div
      class="bg-[#341D65] relative rounded-md md:col-span-3 col-span-1 overflow-hidden aspect-[8/7]"
    >
      <Image
        src={background}
        class="absolute top-0 left-0 w-full h-full object-cover z-0"
        alt=""
        quality={100}
      />

      <WwChat client:only="vue" class="z-10 will-change-transform origin-top" />
    </div>

    <div class="flex justify-between items-center py-2">
      Designing for AI

      <a href="/" class="flex items-center gap-2">
        5 min read
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          fill="currentColor"
          viewBox="0 0 256 256"
          ><path
            d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"
          ></path></svg
        >
      </a>
    </div>
  </div>
</section>
